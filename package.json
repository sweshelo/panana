{
  "name": "panana",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.2",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^5",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "fflate": "^0.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-tooltip": "^6.0.8",
    "three": "^0.186.1",
    "wrangler": "^4.141.0"
  },
  "scripts": {
    "prepare": "bun scripts/lefthook.ts install",
    "hooks:install": "bun scripts/lefthook.ts install",
    "check": "bun scripts/quiet-check.ts lint && bun scripts/quiet-check.ts format:check && bun scripts/quiet-check.ts typecheck && bun scripts/quiet-check.ts test",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "bun run build && wrangler dev",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "golden": "python test/golden/export_golden.py",
    "deploy": "bun run build && wrangler deploy",
    "app": "bun server/main.ts",
    "build:exe": "bun scripts/build-exe.ts"
  }
}
